# Jekyll build output
_site/
.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local content archive + image staging (kept locally, not published)
_source/

# Node tooling (Puppeteer QA / screenshots)
node_modules/
npm-debug.log*
package-lock.json
# ...except the CI image step's lockfile, which pins the sharp version CI installs
!.github/scripts/package-lock.json

# Written by the CI image step (.github/scripts/prepare-images.mjs) before each build;
# never committed
assets/images/thumbs/
_data/generated_images.json

# One-off harvest/render tooling (local only, not part of the site)
harvest.js
harvest_results.json
render_thumbs.py

# One-off abstract pipeline: fetch/scrape/inject/QA (local only, not part of the site)
fetch-abstracts.js
fetch-crossref.js
fetch-openalex.js
refetch-openalex2.js
scrape-abstracts.js
scrape-retry.js
scrape-33.js
inject-abstracts.js
fix-unicode.js
qa.js

# OS
.DS_Store
Thumbs.db
*.log

# Local QA artifacts (parity diffs, screenshots)
.qa/
